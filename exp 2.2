clear;
clc;
close all;

% Define study area in square kilometres
studyAreaKm2 = 4.0;

% Define cell radii in kilometres
cellRadiiKm = [1.00, 0.75, 0.50];

% Calculate the area of a regular hexagonal cell
cellAreaKm2 = (3 * sqrt(3) / 2) .* cellRadiiKm.^2;

% Estimate the number of cells required
estimatedCells = ceil(studyAreaKm2 ./ cellAreaKm2);

% Create a results table
results = table( ...
    cellRadiiKm', ...
    cellAreaKm2', ...
    estimatedCells', ...
    'VariableNames', { ...
    'CellRadius_km', ...
    'CellArea_km2', ...
    'EstimatedNumberOfCells'});

% Display the results
disp('Estimated cells required:');
disp(results);

% Plot cell radius versus estimated number of cells
figure;

bar(cellRadiiKm, estimatedCells, 0.6);

xlabel('Cell radius (km)');
ylabel('Estimated number of cells');

title('Cell Radius versus Estimated Number of Cells');

grid on;

% Display the cell radius values in ascending order on the x-axis
xticks(cellRadiiKm);
hold off;
