clc;
clear;
close all;

% Define component carrier parameters
BWcc = 20;              % Bandwidth per component carrier (MHz)
SE = 4;                 % Spectral efficiency (bits/s/Hz)
CC = [1 2 3];            % Number of component carriers

% Calculate aggregated bandwidth and throughput
AggBW = BWcc .* CC;
Throughput = AggBW .* SE;

% Display results
disp('CC   Aggregated BW (MHz)   Estimated Throughput (Mbps)');
disp([CC' AggBW' Throughput']);

% Plot carrier aggregation throughput
figure;

bar(CC, Throughput, 0.6);

grid on;
xlabel('Number of Aggregated Component Carriers');
ylabel('Estimated Throughput (Mbps)');
title('LTE-Advanced Carrier Aggregation Throughput');

% Set axis values
xticks(CC);
ylim([0 280]);

% Display throughput values above each bar
for k = 1:length(CC)
    text(CC(k), Throughput(k), ...
        sprintf('%.0f Mbps', Throughput(k)), ...
        'HorizontalAlignment', 'center', ...
        'VerticalAlignment', 'bottom');
end

drawnow;
